# Frontend + API edge. The SPA and the API share one origin (no CORS needed).
worker_processes auto;
events { worker_connections 8192; }

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;
  sendfile on; tcp_nopush on; keepalive_timeout 65;
  server_tokens off;
  client_max_body_size 1m;
  gzip on; gzip_comp_level 5; gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;
  log_format json escape=json '{"ts":"$time_iso8601","status":$status,"method":"$request_method",'
                              '"uri":"$uri","ms":$request_time,"ip":"$remote_addr","rid":"$request_id"}';
  access_log /dev/stdout json;

  # Docker's DNS; re-resolve so every api_gateway replica gets traffic
  resolver 127.0.0.11 valid=10s ipv6=off;
  limit_req_zone $binary_remote_addr zone=api:20m rate=30r/s;

  map $http_upgrade $connection_upgrade { default upgrade; '' close; }

  # The client IP the gateway rate-limits on. Never taken from X-Forwarded-For
  # (any client can write that). Behind CloudFront (TRUST_CLOUDFRONT=on, and the
  # origin only reachable from CloudFront) it is CloudFront's viewer address;
  # otherwise the TCP peer.
  map "${TRUST_CLOUDFRONT}|$http_cloudfront_viewer_address" $client_ip {
    default $remote_addr;
    "~^on\|(?<cfip>.+):[0-9]+$" $cfip;
  }

  # 1 = request may enter. No ORIGIN_SECRET (local) -> always; else the header must match it.
  map "${ORIGIN_SECRET}|$http_x_origin_verify" $origin_ok {
    default 0;
    "~^\|" 1;
    "~^(?<want>[^|]+)\|(?P=want)$" 1;
  }

  include /etc/nginx/conf.d/*.conf;
}
