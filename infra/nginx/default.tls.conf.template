# AWS: CloudFront reaches the origin over HTTPS only (docker-compose.aws.yml mounts
# this over default.conf.template). The certificate (Let's Encrypt, scripts/origin_cert.sh)
# covers the site domain and origin.<domain>: CloudFront checks it against both.
server {
  listen 443 ssl;
  http2 on;
  ssl_certificate     /etc/letsencrypt/live/${ORIGIN_HOST}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${ORIGIN_HOST}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:TLS:10m;
  ssl_session_timeout 1d;
  include /etc/nginx/site.inc;
}

# Container health check only: not published, and the security group admits 443 alone.
server {
  listen 8080;
  allow 127.0.0.1;
  deny all;
  location = /healthz { return 200 "ok\n"; }
}
