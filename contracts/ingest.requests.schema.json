{
  "$defs": {
    "EmitCandidate": {
      "description": "An EMIT acquisition from the platform catalog that fully covers the job's box.",
      "properties": {
        "granule_id": {
          "title": "Granule Id",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "acquired_at": {
          "title": "Acquired At",
          "type": "string"
        },
        "cloud_cover": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cloud Cover"
        }
      },
      "required": [
        "granule_id",
        "acquired_at"
      ],
      "title": "EmitCandidate",
      "type": "object"
    }
  },
  "description": "ingest.requests: gateway -> ingestion.",
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "ts": {
      "title": "Ts",
      "type": "string"
    },
    "user_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Id"
    },
    "bbox": {
      "items": {
        "type": "number"
      },
      "title": "Bbox",
      "type": "array"
    },
    "tasks": {
      "items": {
        "enum": [
          "agriculture",
          "mineral",
          "thermal"
        ],
        "type": "string"
      },
      "title": "Tasks",
      "type": "array"
    },
    "date_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date From"
    },
    "date_to": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date To"
    },
    "source": {
      "default": "nasa",
      "enum": [
        "nasa",
        "fixture"
      ],
      "title": "Source",
      "type": "string"
    },
    "emit_candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EmitCandidate"
      },
      "title": "Emit Candidates",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "bbox",
    "tasks"
  ],
  "title": "IngestRequest",
  "type": "object"
}
