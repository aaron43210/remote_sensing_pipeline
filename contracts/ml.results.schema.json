{
  "$defs": {
    "Layer": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "tif_key": {
          "title": "Tif Key",
          "type": "string"
        },
        "png_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Png Key"
        },
        "bounds": {
          "items": {
            "type": "number"
          },
          "title": "Bounds",
          "type": "array"
        },
        "units": {
          "default": "",
          "title": "Units",
          "type": "string"
        },
        "kind": {
          "default": "continuous",
          "enum": [
            "continuous",
            "categorical"
          ],
          "title": "Kind",
          "type": "string"
        },
        "colormap": {
          "default": "viridis",
          "title": "Colormap",
          "type": "string"
        },
        "vmin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vmin"
        },
        "vmax": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vmax"
        },
        "classes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Classes"
        },
        "stats": {
          "additionalProperties": true,
          "default": {},
          "title": "Stats",
          "type": "object"
        }
      },
      "required": [
        "name",
        "tif_key",
        "bounds"
      ],
      "title": "Layer",
      "type": "object"
    }
  },
  "description": "ml.results: ml_inference -> orchestrator. One per task.",
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "ts": {
      "title": "Ts",
      "type": "string"
    },
    "task": {
      "enum": [
        "agriculture",
        "mineral",
        "thermal"
      ],
      "title": "Task",
      "type": "string"
    },
    "model_version": {
      "title": "Model Version",
      "type": "string"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/Layer"
      },
      "title": "Layers",
      "type": "array"
    },
    "summary": {
      "additionalProperties": true,
      "default": {},
      "title": "Summary",
      "type": "object"
    },
    "verification": {
      "additionalProperties": true,
      "default": {},
      "title": "Verification",
      "type": "object"
    },
    "timings": {
      "additionalProperties": true,
      "default": {},
      "title": "Timings",
      "type": "object"
    },
    "acquired_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acquired At"
    }
  },
  "required": [
    "job_id",
    "task",
    "model_version",
    "layers"
  ],
  "title": "MLResult",
  "type": "object"
}
