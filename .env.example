# =============================================================
# OWNER: AARON
# Production Environment Variables
# Copy this to .env and fill in real values before deploying
# NEVER commit the real .env file to git!
# =============================================================

# MinIO (Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production_use_32_chars

# PostgreSQL
DB_USER=spectral
DB_PASSWORD=change_me_in_production

# JWT Auth (use a strong random secret: openssl rand -hex 32)
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# NASA Earthdata Token (get from https://urs.earthdata.nasa.gov)
NASA_EARTHDATA_TOKEN=your_token_here

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
