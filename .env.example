# Copy to .env and fill in. Never commit .env.
# The SAME keys are used locally (MinIO) and on AWS (S3): only values change.

ENV=local
TAG=dev

# ── Secrets (generate: openssl rand -hex 32) ───────────────────────────────
JWT_SECRET=
# Key rotation: move the old JWT_SECRET here for one refresh period (14 days), then remove it
JWT_PREVIOUS_SECRET=
# Encrypts every user's NASA Earthdata token. Changing it disconnects all users'
# NASA accounts (each reconnects once in the app).
CREDENTIALS_KEY=
DB_USER=spectral
DB_PASSWORD=
GRAFANA_PASSWORD=

# ── Sign-in: Google only ───────────────────────────────────────────────────
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URI must equal OAUTH_REDIRECT_URL exactly. Never commit the client JSON.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/google/callback
# Who may sign in (comma-separated). Domains are Google Workspace domains, or gmail.com.
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=
# true = any verified Google account (off: every job costs compute)
OPEN_SIGNUP=false
# Becomes admin (sees every job) when signing in with this Google account
ADMIN_EMAIL=
# Tests only: http://mock-oidc:9998 (docker compose --profile test). Production must keep Google.
OIDC_ISSUER=https://accounts.google.com

# ── Object storage ─────────────────────────────────────────────────────────
# Local MinIO: keep these. AWS: S3_ENDPOINT_URL= and S3_PUBLIC_ENDPOINT_URL=
# empty, S3_FORCE_PATH_STYLE=false, S3_CREATE_BUCKET=false, no AWS keys
# (the EC2 instance role is used). Other S3-compatible hosts (R2, B2, Wasabi):
# set the endpoint, keys and region they give you.
S3_BUCKET=hyperspectral-local
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-west-2
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
# Locally these are the MinIO root user and password (20+ characters).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── NASA Earthdata (EMIT downloads). Either a token or username/password ──
# Users connect their OWN token in the app (Minerals/Agriculture); jobs use it.
# This platform account is only for the batch pipelines (Dagster) and
# scripts. https://urs.earthdata.nasa.gov  -> Generate Token
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ── Product limits ─────────────────────────────────────────────────────────
# Origins allowed to call the API with cookies (AWS: https://<your domain> only)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_PORT=3000
# lon_min,lat_min,lon_max,lat_max users may request (default: California)
ALLOWED_REGION=-124.5,32.5,-114.0,42.0
# Synthetic fixture scenes, API only (the UI always uses real imagery); the test suites need true
ALLOW_FIXTURES=false
# Cloudiest EMIT scene (%) a job may use; the map's coverage layer shows the same scenes
EMIT_MAX_CLOUD=40
MAX_ACTIVE_JOBS_PER_USER=3
MAX_QUEUED_JOBS=500
RATE_LIMIT_PER_MIN=120
SHADOW_SAMPLE_PIXELS=1500
MODEL_VERSION=v1
DB_SSLMODE=disable

# ── Security ───────────────────────────────────────────────────────────────
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=14
# true whenever the site is served over HTTPS (always on AWS)
COOKIE_SECURE=false
PRESIGN_TTL_MIN=15
# on only behind CloudFront (the origin must accept traffic from CloudFront alone)
TRUST_CLOUDFRONT=off
# AWS: CloudFront adds this secret header; nginx refuses requests without it. Empty locally.
ORIGIN_SECRET=
# where the browser fetches map files from (CSP); AWS: https://<bucket>.s3.<region>.amazonaws.com
STORAGE_ORIGIN=http://localhost:9000
