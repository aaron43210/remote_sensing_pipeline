FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY services/rtm_inversion/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy the four service files.
COPY services/rtm_inversion/ /app/

# Copy the trained NN artifacts into the location expected by main.py.
COPY models/rtm_inversion_nn/ /models/rtm_inversion_nn/

# main.py resolves artifacts relative to the project root. In the
# container, create that same expected directory layout.
RUN mkdir -p /remote_sensing_pipeline/models \
    && ln -s /models/rtm_inversion_nn \
       /remote_sensing_pipeline/models/rtm_inversion_nn

ENV RTM_PROJECT_DIR=/remote_sensing_pipeline

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
